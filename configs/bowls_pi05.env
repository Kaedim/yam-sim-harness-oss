# bowls / pi0.5
# Values read from the published runs' own logs (C2_bowls_pi05, S7_PS_bowls_pi05).
# Every other variable the runner accepts stayed at its default in these runs.
# Each value below is a default: set the same name in your environment and yours wins,
# so TRIALS=1 gives a quick check without editing this file.

TASKSET=${TASKSET:-bowls}
CHUNK_STEPS=${CHUNK_STEPS:-16}
ITERS=${ITERS:-225}            # 225 x 16 = 3600 steps (real rig: 3600)
TRIALS=${TRIALS:-20}
TOP_H=${TOP_H:-0.72}         # pi0.5 is evaluated at this height
LAYOUT=${LAYOUT:-v3}
RIG=${RIG:-rig6}
