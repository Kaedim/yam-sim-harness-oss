# latte / MolmoAct2
# Values read from the published runs' own logs (V2_K_latte_molmo, S4_PS_latte_molmo).
# Every other variable the runner accepts stayed at its default in these runs.
# Each value below is a default: set the same name in your environment and yours wins,
# so TRIALS=1 gives a quick check without editing this file.

TASKSET=${TASKSET:-latte}
CHUNK_STEPS=${CHUNK_STEPS:-30}
ITERS=${ITERS:-120}            # 120 x 30 = 3600 steps (real rig: 3600)
TRIALS=${TRIALS:-20}
TOP_H=${TOP_H:-0.88}         # MolmoAct2 is evaluated at this height
LAYOUT=${LAYOUT:-v3}
# start poses: the runner derives the key 'latte_molmo' from task + policy
# (isaac_trials.py:522). The real rig changed between policies on this task,
# so it is not settable and must not be overridden.
RIG=${RIG:-rig1}
MOLMO_NUM_STEPS=${MOLMO_NUM_STEPS:-10}   # flow-matching denoising steps, real rig default
